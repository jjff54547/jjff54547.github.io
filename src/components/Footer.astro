---
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <p>&copy; {today.getFullYear()} 吉福. Built with Astro.</p>
    <div class="links">
      <a href="mailto:jjff54547@gmail.com">Email</a>
      <a href="https://github.com/jjff54547" target="_blank">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--c-border);
    padding: 32px 24px;
    margin-top: 80px;
  }
  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--c-text-secondary);
    font-size: 0.85rem;
  }
  .links {
    display: flex;
    gap: 20px;
  }
  .links a {
    color: var(--c-text-secondary);
    font-weight: 500;
  }
  .links a:hover { color: var(--c-accent); }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
