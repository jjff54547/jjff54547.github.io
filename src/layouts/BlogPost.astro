---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main class="container">
      <article class="prose">
        <header class="post-header">
          {heroImage && (
            <div class="hero-image">
              <img src={heroImage.src} alt={title} />
            </div>
          )}
          <div class="post-meta">
            <FormattedDate date={pubDate} />
            {updatedDate && <span class="updated"> · 更新于 <FormattedDate date={updatedDate} /></span>}
          </div>
          <h1>{title}</h1>
          {tags && tags.length > 0 && (
            <div class="post-tags">
              {tags.map((t: string) => <span class="tag">{t}</span>)}
            </div>
          )}
        </header>
        <div class="post-body">
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .prose {
    max-width: 720px;
    margin: 0 auto;
  }
  .post-header {
    text-align: center;
    padding: 48px 0 32px;
  }
  .post-meta {
    font-size: 0.85rem;
    color: var(--c-text-secondary);
    margin-bottom: 12px;
  }
  .hero-image {
    margin-bottom: 24px;
    border-radius: 12px;
    overflow: hidden;
  }
  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .post-meta .updated { font-style: italic; }
  .post-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 12px;
  }
  .post-tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .post-body {
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .post-body :global(h2) {
    margin-top: 2em;
    margin-bottom: 0.5em;
  }
  .post-body :global(h3) {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .post-body :global(p) {
    margin-bottom: 1.2em;
  }
  .post-body :global(ul), .post-body :global(ol) {
    margin-bottom: 1.2em;
    padding-left: 1.5em;
  }
  .post-body :global(li) {
    margin-bottom: 0.4em;
  }
  .post-body :global(img) {
    margin: 1.5em auto;
    display: block;
  }
</style>
