---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.tags.includes(tag)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagLabels: Record<string, string> = {
  ai: 'AI & Python',
  trade: '外贸 & 出海',
  product: '产品想法',
  life: '人生记录',
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`${tagLabels[tag] || tag} | 吉福的实验室`} description={`标签: ${tagLabels[tag] || tag} 下的所有文章`} />
  </head>
  <body>
    <Header />
    <main class="container">
      <section class="tag-header">
        <h1>{tagLabels[tag] || tag}</h1>
        <p>{posts.length} 篇文章</p>
        <a href="/blog" class="back-link">&larr; 所有文章</a>
      </section>
      <section>
        {
          posts.length === 0 ? (
            <p class="empty">这个标签下还没有文章。</p>
          ) : (
            <div class="post-grid">
              {posts.map((post) => (
                <a href={`/blog/${post.id}/`} class="card post-item">
                  <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <div class="post-tags">
                    {post.data.tags.map((t: string) => <span class="tag">{t}</span>)}
                  </div>
                </a>
              ))}
            </div>
          )
        }
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .tag-header {
    text-align: center;
    padding: 48px 0 24px;
  }
  .tag-header h1 { margin-bottom: 4px; }
  .tag-header p { color: var(--c-text-secondary); font-size: 0.95rem; margin-bottom: 12px; }
  .back-link { font-size: 0.9rem; color: var(--c-accent); }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }
  .post-item {
    display: block;
  }
  .post-item h3 {
    font-size: 1.15rem;
    margin: 6px 0 4px;
    color: var(--c-text);
  }
  .post-item p {
    font-size: 0.9rem;
    color: var(--c-text-secondary);
    line-height: 1.5;
  }
  .post-date { font-size: 0.8rem; color: var(--c-text-secondary); }
  .post-tags { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px; }
  .empty { text-align: center; color: var(--c-text-secondary); padding: 60px 0; }
</style>
